# openjev-ultrafast 配置模板。复制为 .env 并填值;key 只放 .env(已被 gitignore)。
# 当前默认底座:StartLux-Decision-2B(GGUF,本地,TypeSafe wire 兼容)。

# --- Decision:StartLux gguf_server(scripts/startlux_serve.ps1 拉起 :8090)---
DECIDER_MODE=typesafe
TYPESAFE_BASE_URL=http://127.0.0.1:8090/v1/systemone
TYPESAFE_API_KEY=local

# --- 旧底座:decider-2B(:8000) —— 已关闭的线。run_baseline_19.ps1 的默认现在是 8090,
#     想再用这条线必须显式传 -SvcPort 8000(不传 -NoService 时它会自己去起 :8000)。
# DECIDER_2B_BASE_URL=http://127.0.0.1:8000/v1
# DECIDER_2B_MODEL=decider-2b
# DECIDER_2B_API_KEY=sk-local

# --- Text Helper(TYPE_TEXT 时从页面取字段值;OpenAI 兼容)---
# 零云端硬线(2026-10-08):这里曾经是 Groq 默认,于是每次填字段都把页面内容送进
# 云端模型,而报表的 api_calls 一直是 0 —— 那个计数器只统计 teacher 路径。
# 默认端点必须是本机 llama-server(:8081,和 StartLux wire 同一个模型)。
TEXT_HELPER_BASE_URL=http://127.0.0.1:8081/v1
TEXT_HELPER_MODEL=startlux-decision-2b
TEXT_HELPER_API_KEY=local
# 云端 helper 只能显式指定(-TextHelper groq|deepseek,由 scripts/text_helper.ps1 解析):
# TEXT_HELPER_BASE_URL=https://api.groq.com/openai/v1
# TEXT_HELPER_MODEL=openai/gpt-oss-120b
# TEXT_HELPER_API_KEY=<your key>

# --- 可选:出口代理(部分网络直连 Groq 会 403)---
HTTPX_PROXY=http://127.0.0.1:2080
